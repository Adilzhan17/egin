# ── Supabase PostgreSQL ───────────────────────────────────────────────────────
#
# Найди строку подключения в: Supabase Dashboard → Project → Settings → Database
#
# Вариант A: Supabase Supavisor (pooler, рекомендован для production)
#   Project Settings → Database → Connection string → URI → Transaction mode
#   Порт ОБЯЗАТЕЛЬНО 6543
#
# DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
#
# Вариант B: Прямое подключение (без pooler, для миграций и CLI)
#   Project Settings → Database → Connection string → URI → Direct connection
#   Порт ОБЯЗАТЕЛЬНО 5432
#
# DATABASE_URL="postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Security ──────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:3000,https://egin.kz"
JWT_SECRET=generate-with-openssl-rand-hex-48
