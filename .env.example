# Local development. `docker compose up --build` also works without this file.
POSTGRES_DB=egin
POSTGRES_USER=egin
# Change before exposing beyond localhost. Keep the existing password when reusing a volume.
POSTGRES_PASSWORD=egin-local-development
DB_PORT=55432
API_PORT=8000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
# Empty: CORE generates a persistent local secret under artifacts/session-secret (0600).
SESSION_SECRET=
COOKIE_SECURE=false
# Preferred hosted provider. Empty LLM_PROVIDER auto-selects Gemini when a key is present,
# otherwise starts local Ollama inside CORE. Do not commit actual API keys.
GEMINI_API_KEY=
LLM_PROVIDER=
# Gemini: empty discovers available Flash models. Ollama: e.g. qwen3:1.7b.
LLM_MODEL=
OLLAMA_MODEL=qwen3:1.7b
# Empty: local loopback Ollama inside CORE. External server URL is also supported.
OLLAMA_URL=
# CPU package currently supports linux/amd64. Set 0 for hosted AI on other architectures.
WITH_OLLAMA=1
# Optional OpenAI-compatible provider:
LLM_BASE_URL=
LLM_API_KEY=

# Optional server-only Google integrations. No NEXT_PUBLIC secrets.
# Weather falls back to Open-Meteo until enabled and verified.
FEATURE_GOOGLE_WEATHER=false
GOOGLE_WEATHER_API_KEY=
FEATURE_GOOGLE_WEATHERNEXT=false
GOOGLE_CLOUD_PROJECT=
# Files live in ./secrets (ignored by Git), mounted read-only in CORE.
GOOGLE_CLOUD_ACCESS_TOKEN_FILE=
GOOGLE_WEATHERNEXT_BQ_TABLE=
GOOGLE_WEATHERNEXT_BQ_LOCATION=US
GOOGLE_WEATHERNEXT_MAX_BYTES_BILLED=100000000
FEATURE_GOOGLE_EARTH_ENGINE=false
GOOGLE_APPLICATION_CREDENTIALS=
# ALU/AMED currently do not cover Kazakhstan; these remain disabled.
FEATURE_GOOGLE_AGRICULTURE=false
GOOGLE_AGRICULTURE_API_KEY=
